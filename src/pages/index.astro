---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import GameCard from '../components/GameCard.astro';
import { games, crew } from '../data/studio';
---
<Base>
  <Header />
  <main id="main">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy"><p class="eyebrow"><span class="red-line" aria-hidden="true"></span> Independent game studio</p><h1 id="hero-heading">Original games.<br /><em>Cold blood.</em></h1><p class="hero-description">Welcome to Cold Blooded Studios.<br />Meet the crew. Discover what we’re creating.</p><div class="actions"><a class="button" href="#games">Explore our games <span aria-hidden="true">↗</span></a><a class="text-link" href="#studio">Meet the studio <span aria-hidden="true">→</span></a></div></div>
      <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="crosshair crosshair-one">+</span><span class="crosshair crosshair-two">+</span><img class="hero-snake" src="/mascots/kirk.webp" alt="" width="720" height="720" fetchpriority="high" /><span class="art-coordinate">CBS / KIRK — 001</span><span class="vertical-label">INSTINCT. IDENTITY. ORIGINALITY.</span></div>
      <div class="hero-footer"><span>Three creatures. One studio.</span><a href="#games">Discover the projects <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="section shell" id="games" aria-labelledby="games-heading"><div class="section-heading"><div><p class="eyebrow">01 / Our original games</p><h2 id="games-heading">Worlds of our own.</h2></div><p>Two original projects.<br />One unmistakable studio identity.</p></div><div class="games-grid">{games.map(game => <GameCard game={game} />)}</div></section>
    <section class="studio-section" id="studio" aria-labelledby="studio-heading"><div class="shell section"><div class="section-heading"><div><p class="eyebrow">02 / Behind the studio</p><h2 id="studio-heading">Meet the cold bloods.</h2></div><p>Black silhouettes. Ruby red eyes.<br />Kirk, Jerry, and Bryan.</p></div><div class="crew-grid">{crew.map((member, i) => <article class="crew-card"><div class="portrait"><span class="portrait-index" aria-hidden="true">0{i + 1}</span><img src={member.image} alt={member.alt} width="720" height="720" loading="lazy" /></div><div class="crew-caption"><h3>{member.name}</h3><p>{member.species}</p></div></article>)}</div><p class="studio-note">A shared identity. A space for original ideas.<br />This is Cold Blooded Studios.</p></div></section>
    <section class="section shell" id="experiments" aria-labelledby="experiments-heading"><div class="lab"><div><p class="eyebrow">03 / The experimental corner</p><h2 id="experiments-heading">Outside the originals.</h2><p>A separate space for fan projects and experiments.</p></div><article class="experiment"><span class="badge">Experimental fan project</span><h3>TARKRAFT</h3><p>TARKRAFT is an experimental fan project, separate from our original games Gilt &amp; Guilt and Pocket Vein.</p><p class="fine-print">Unofficial fan work. No affiliation or endorsement is implied. Referenced names and properties belong to their respective owners.</p><details><summary>About this experiment <span aria-hidden="true">+</span></summary><p>Project details and any future access links will be added after review. No third-party game artwork or logos are used on this page.</p></details></article></div></section>
    <section class="connect-section" id="connect" aria-labelledby="connect-heading"><div class="shell connect-inner"><div><p class="eyebrow">Stay close to the studio</p><h2 id="connect-heading">Follow the next chapter.</h2><p>Explore the studio’s work on GitHub.</p></div><a class="button" href="https://github.com/coldbloodedstudios1">Visit studio GitHub <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <footer class="shell footer"><a class="footer-name" href="#">Cold Blooded Studios</a><p>Original games. Cold blood.</p><a href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
</Base>
